# Template: runs scripts/backup_r2.sh once (see the README's backup section).
# Runs as root: the script reads the root-only .env.backup and dumps the
# database through mysqldump's socket login. Fix the path, then install it
# together with flog-backup.timer.
[Unit]
Description=flog backup to Cloudflare R2
After=mysql.service network-online.target
Wants=mysql.service network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/srv/flog/app/scripts/backup_r2.sh
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
