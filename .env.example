# 复制为 .env 后按需修改。.env 不要提交到版本库。

# 会话与 CSRF 的签名密钥，必填，请使用足够长的随机值
SECRET_KEY=replace-with-a-long-random-value

# 数据库连接；不设置时使用 instance/flog.sqlite3
DATABASE_URL=mysql+pymysql://user:password@localhost/flog

# 管理员邮箱，多个用逗号分隔：作为出错通知的收件人和重置密码邮件的发件人
ADMIN_EMAILS=admin@example.com

# 邮件（重置密码、评论通知、出错通知）。MAIL_SERVER 留空则不发邮件
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=admin@example.com
MAIL_PASSWORD=replace-me
# 发件地址，可选。SMTP 用户名不是邮箱地址时必须设置（如 Resend 的用户名是 resend，
# 发件地址要用已验证域名下的地址）；留空则用 MAIL_USERNAME，再不行用 ADMIN_EMAILS 的第一个
MAIL_FROM=
# 后台“邮件”页写信时可选的发件地址，逗号分隔（须是 Resend 已验证域名下的地址）；MAIL_FROM 也始终可选
MAIL_SENDERS=

# 后台“邮件”页读取 Resend 上收发的邮件（只发 GET 请求）。需要 Full access 密钥，
# Resend 的只发信密钥读不了列表；建议单独建一把专给后台用的密钥。留空则该页只显示配置说明
RESEND_API_KEY=

# 上传图片的保存目录，相对路径以项目根目录为准
UPLOAD_FOLDER=instance/uploads
# Live Photo 视频转码需要 ffmpeg；留空则使用 PATH 中的 ffmpeg
FFMPEG_PATH=

# 播客：单集音频的大小上限（MB），默认 300
# PODCAST_AUDIO_MAX_MB=300
# 本站的公开网址，用于把旧播客域名重定向过来（不带结尾斜杠）
# SITE_URL=https://example.com
# 以前是播客独立站的域名，逗号分隔；访问它们会 301 到 SITE_URL 下的 /podcast/。
# 这些域名还需要在反向代理（Caddy）里指向本应用
# PODCAST_REDIRECT_HOSTS=podcast.example.com

# 可选：页面上日期的显示时区（数据库里统一存 UTC）。默认 Asia/Shanghai
# DISPLAY_TIMEZONE=Asia/Shanghai

# 可选：Google 统计。默认不加载任何统计代码；需要时取消注释并填入自己的 ID
# GTM_ID=GTM-XXXXXXX
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 可选：应用前面有几层反向代理（Caddy 为 1，默认 1；直接暴露应用时设为 0）。
# 用来取得访客真实 IP，点赞的同网络限制依赖它
# TRUSTED_PROXY_HOPS=1
